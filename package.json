{
  "name": "velozity-client-project-dashboard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@velozity/api",
    "dev:web": "npm run dev --workspace=@velozity/web"
  },
  "engines": {
    "node": ">=20"
  }
}
